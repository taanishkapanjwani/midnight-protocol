# The Midnight Protocol - copy to .env (in this folder OR the folder above) and fill in.
# The app looks for .env in the repo folder first, then one level up.

# Portkey gateway key. Required for live AI. Without it the app runs in a clearly labeled DEMO MODE.
PORTKEY_API_KEY=
# Optional: your own OpenAI key (used only if PORTKEY_API_KEY is not set).
OPENAI_API_KEY=

# Model name.
LLM_MODEL=gpt-6-luna

# Pricing in USD per 1M tokens, used for the Royal Treasury. Set these to your model's published prices.
PRICE_INPUT_PER_M=0.10
PRICE_CACHED_INPUT_PER_M=0.01
PRICE_OUTPUT_PER_M=0.50

# Safety caps
MAX_LLM_CALLS_PER_RUN=6
LLM_TIMEOUT_MS=60000
DAILY_SPEND_CAP_USD=5

PORT=8787
