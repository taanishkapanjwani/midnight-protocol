{
  "name": "midnight-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "The Midnight Protocol - a multi-agent AI stylist that rescues outfits before midnight.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,yellow \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "eval": "tsx eval/run.ts",
    "test:safety": "tsx eval/safety.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=18.18" }
}
